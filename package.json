{
  "name": "ufitpal",
  "types": "module",
  "version": "2.18.29",
  "bin": {
    "ufitpal": "./scripts/init.js"
  },
  "files": [
    "scripts/init.js"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo run dev --filter=api --filter=studio --filter=ecom-store",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "bump-deps": "npx npm-check-updates --deep -u -x react-day-picker && pnpm install",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/design-system",
    "migrate": "cd packages/database && npx prisma format && npx prisma generate && npx prisma db push",
    "prepare": "husky",
    "lint": "turbo lint --filter=api ",
    "commit": "gitmoji -c",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:migrate": "turbo run db:migrate --filter=@repo/database",
    "db:generate": "turbo run db:generate --filter=@repo/database"
  },
  "devDependencies": {
    "@auto-it/all-contributors": "^11.3.0",
    "@auto-it/first-time-contributor": "^11.3.0",
    "@biomejs/biome": "1.9.4",
    "@next/eslint-plugin-next": "^15.1.6",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.6",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.6",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-next": "^0.0.0",
    "gitmoji-cli": "^9.5.0",
    "husky": "^9.1.7",
    "prettier": "3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "ultracite": "^4.1.15"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.2.1",
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^6.3.1",
    "@prisma/client": "6.3.1",
    "import-in-the-middle": "^1.13.0",
    "prisma": "6.3.1",
    "require-in-the-middle": "^7.5.1",
    "server-only": "^0.0.1",
    "undici": "^7.3.0",
    "ws": "^8.18.0"
  },
  "resolutions": {
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1"
  }
}
